# RojgarBridge Backend Configuration
PORT=8080
ENV=production

# Neon PostgreSQL Database URL (Use Direct/Unpooled connection for Go server)
DATABASE_URL=postgresql://neondb_owner:password@ep-summer-pine-b5wbf1jf.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Fallback SQLite DB path (only used if DATABASE_URL is not set)
DB_PATH=rojgarbridge.db

# Optional: Add your Gemini API Key for deep AI notification extraction
# If not set, system automatically uses the smart rule-based fallback extractor
GEMINI_API_KEY=

# Optional: Instant Telegram Alerts when jobs are published
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
